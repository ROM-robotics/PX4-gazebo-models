<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_four_cams'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include>
      <uri>model://mono_cam</uri>
      <pose>.12 .03 .242 0 0 0</pose>
      <name>front_camera</name>
    </include>
    <include>
      <uri>model://mono_cam</uri>
      <pose>-.12 0 .242 0 0 3.1416</pose>
      <name>back_camera</name>
    </include>
    <include>
      <uri>model://mono_cam</uri>
      <pose>0 .12 .242 0 0 1.5708</pose>
      <name>left_camera</name>
    </include>
    <include>
      <uri>model://mono_cam</uri>
      <pose>0 -.12 .242 0 0 -1.5708</pose>
      <name>right_camera</name>
    </include>
    <joint name="frontCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera::camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
    <joint name="backCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>back_camera::camera_link</child>
      <pose relative_to="base_link">-.12 0 .242 0 0 3.1416</pose>
    </joint>
    <joint name="LeftCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>left_camera::camera_link</child>
      <pose relative_to="base_link">0 .12 .242 0 0 1.5708</pose>
    </joint>
    <joint name="RightCameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>right_camera::camera_link</child>
      <pose relative_to="base_link">0 -.12 .242 0 0 -1.5708</pose>
    </joint>
  </model>
</sdf>
